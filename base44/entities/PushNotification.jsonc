{
  "name": "PushNotification",
  "type": "object",
  "properties": {
    "recipient_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "message",
        "alert",
        "schedule",
        "compliance",
        "incident"
      ],
      "description": "Notification type"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "critical"
      ],
      "default": "normal"
    },
    "action_url": {
      "type": "string",
      "description": "Link to relevant page"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "recipient_email",
    "title",
    "body",
    "type"
  ]
}