{
  "name": "WorkflowExecution",
  "type": "object",
  "properties": {
    "workflow_id": {
      "type": "string"
    },
    "workflow_name": {
      "type": "string"
    },
    "trigger_entity_type": {
      "type": "string",
      "description": "What entity triggered this (DocumentUpload, Asset, etc.)"
    },
    "trigger_entity_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "failed",
        "paused"
      ],
      "default": "pending"
    },
    "current_step_index": {
      "type": "number",
      "default": 0
    },
    "step_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "result": {
            "type": "object"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "pending_approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string"
          },
          "assigned_to_email": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          }
        }
      }
    },
    "error_message": {
      "type": "string"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "workflow_id",
    "trigger_entity_type",
    "trigger_entity_id"
  ]
}