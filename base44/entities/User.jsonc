{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "enterprise_site_owner",
        "site_owner",
        "admin",
        "user"
      ],
      "default": "user",
      "description": "User access level. enterprise_site_owner and site_owner get full access + Enterprise menu. admin gets management tools (no billing/settings). user gets basic nav only."
    }
  },
  "required": []
}