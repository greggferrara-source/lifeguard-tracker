{
  "name": "SystemLog",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "default": "info",
      "description": "Log level"
    },
    "category": {
      "type": "string",
      "enum": [
        "checkout",
        "subscription",
        "webhook",
        "auth",
        "email",
        "sms",
        "database",
        "api",
        "other"
      ],
      "description": "Error category"
    },
    "message": {
      "type": "string",
      "description": "Error message"
    },
    "context": {
      "type": "string",
      "description": "Additional context/stack trace"
    },
    "user_email": {
      "type": "string",
      "description": "User email if applicable"
    },
    "resolved": {
      "type": "boolean",
      "default": false,
      "description": "Whether error has been addressed"
    }
  },
  "required": [
    "type",
    "category",
    "message"
  ]
}