{
  "name": "Employee",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Employee's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Employee's last name"
    },
    "email": {
      "type": "string",
      "description": "Employee's email address"
    },
    "phone": {
      "type": "string",
      "description": "Employee's phone number"
    },
    "role": {
      "type": "string",
      "enum": [
        "lifeguard",
        "head_lifeguard",
        "supervisor",
        "manager"
      ],
      "default": "lifeguard",
      "description": "Employee role/position"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "on_leave"
      ],
      "default": "active",
      "description": "Employment status"
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "expiry_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "description": "List of certifications with expiry dates"
    },
    "hourly_rate": {
      "type": "number",
      "description": "Hourly pay rate"
    },
    "max_hours_per_week": {
      "type": "number",
      "default": 40,
      "description": "Maximum hours per week"
    },
    "color": {
      "type": "string",
      "description": "Color code for schedule display"
    },
    "avatar_url": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes"
    },
    "location_id": {
      "type": "string",
      "description": "Assigned work location"
    },
    "location_name": {
      "type": "string"
    },
    "gps_tracking_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Opt-in for real-time GPS tracking"
    },
    "emergency_contact_name": {
      "type": "string",
      "description": "Emergency contact person's name"
    },
    "emergency_contact_phone": {
      "type": "string",
      "description": "Emergency contact person's phone number"
    },
    "emergency_contact_relationship": {
      "type": "string",
      "description": "Relationship to emergency contact (e.g., spouse, parent, sibling)"
    }
  },
  "required": [
    "first_name",
    "last_name"
  ]
}