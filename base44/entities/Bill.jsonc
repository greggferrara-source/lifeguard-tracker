{
  "name": "Bill",
  "type": "object",
  "properties": {
    "vendor_id": {
      "type": "string",
      "description": "Associated vendor ID"
    },
    "vendor_name": {
      "type": "string",
      "description": "Vendor name (denormalized)"
    },
    "bill_number": {
      "type": "string",
      "description": "Invoice/bill number"
    },
    "description": {
      "type": "string",
      "description": "What the bill is for"
    },
    "category": {
      "type": "string",
      "description": "Expense category"
    },
    "amount": {
      "type": "number",
      "description": "Total bill amount"
    },
    "amount_paid": {
      "type": "number",
      "default": 0,
      "description": "Amount already paid"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending",
        "approved",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "pending"
    },
    "payment_method": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "File URLs of attached documents"
    },
    "location_id": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "created_by_email": {
      "type": "string"
    }
  },
  "required": [
    "vendor_name",
    "amount",
    "due_date"
  ]
}