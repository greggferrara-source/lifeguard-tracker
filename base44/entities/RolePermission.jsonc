{
  "name": "RolePermission",
  "type": "object",
  "properties": {
    "role_name": {
      "type": "string",
      "description": "Role name (admin, manager, lifeguard, etc.)"
    },
    "role_display_name": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "string",
            "enum": [
              "schedule",
              "employees",
              "certifications",
              "assets",
              "pool_tests",
              "incidents",
              "compliance",
              "documents",
              "reports",
              "workflows",
              "settings",
              "payroll"
            ]
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "create",
                "read",
                "update",
                "delete",
                "approve"
              ]
            }
          },
          "location_restricted": {
            "type": "boolean",
            "default": false,
            "description": "If true, can only access own location"
          }
        }
      },
      "description": "Array of permissions"
    },
    "description": {
      "type": "string"
    }
  },
  "required": [
    "role_name",
    "permissions"
  ]
}