{
  "name": "OnboardingWorkflow",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "employee_email": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "on_hold"
      ],
      "default": "not_started"
    },
    "progress_percentage": {
      "type": "number",
      "default": 0,
      "description": "Overall completion percentage"
    },
    "welcome_email_sent": {
      "type": "boolean",
      "default": false
    },
    "orientation_meeting_scheduled": {
      "type": "boolean",
      "default": false
    },
    "orientation_meeting_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "assigned_mentor_email": {
      "type": "string"
    },
    "assigned_mentor_name": {
      "type": "string"
    },
    "training_modules_assigned": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of assigned training modules"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "assigned_to_email": {
            "type": "string"
          },
          "assigned_to_name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed"
            ]
          },
          "completed_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Onboarding tasks"
    },
    "checklist_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "completed": {
            "type": "boolean"
          },
          "completed_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Onboarding checklist"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "employee_id",
    "start_date"
  ]
}