{
  "name": "MaintenanceReport",
  "type": "object",
  "properties": {
    "location_id": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "reported_by": {
      "type": "string"
    },
    "reported_by_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "equipment",
        "pool_surface",
        "pump_system",
        "chemical_feeder",
        "drain",
        "lighting",
        "safety",
        "other"
      ],
      "default": "equipment"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved"
      ],
      "default": "open"
    },
    "resolved_by": {
      "type": "string"
    },
    "resolved_date": {
      "type": "string",
      "format": "date"
    },
    "resolution_notes": {
      "type": "string"
    }
  },
  "required": [
    "location_id",
    "title",
    "date"
  ]
}