{
  "name": "OperationalFormSubmission",
  "type": "object",
  "properties": {
    "form_id": {
      "type": "string"
    },
    "form_name": {
      "type": "string"
    },
    "form_category": {
      "type": "string"
    },
    "location_id": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "submitted_by_email": {
      "type": "string"
    },
    "submitted_by_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "responses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "warning",
        "fail"
      ],
      "default": "pass"
    },
    "notes": {
      "type": "string"
    },
    "has_alerts": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "form_id",
    "date"
  ]
}