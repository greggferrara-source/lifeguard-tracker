{
  "name": "Channel",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Channel name"
    },
    "description": {
      "type": "string",
      "description": "Channel description"
    },
    "type": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ],
      "default": "public"
    },
    "created_by": {
      "type": "string",
      "description": "Email of creator"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Member emails"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "name"
  ]
}