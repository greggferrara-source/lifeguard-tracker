{
  "name": "PaymentMethod",
  "type": "object",
  "properties": {
    "employee_id": {
      "type": "string",
      "description": "Associated employee ID"
    },
    "employee_name": {
      "type": "string",
      "description": "Employee name (denormalized)"
    },
    "method_type": {
      "type": "string",
      "enum": [
        "direct_deposit",
        "check"
      ],
      "default": "check",
      "description": "Payment method type"
    },
    "account_holder_name": {
      "type": "string",
      "description": "Name on bank account or check"
    },
    "bank_name": {
      "type": "string",
      "description": "Bank name (for direct deposit)"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "checking",
        "savings"
      ],
      "description": "Bank account type"
    },
    "routing_number": {
      "type": "string",
      "description": "Bank routing number"
    },
    "account_number": {
      "type": "string",
      "description": "Bank account number (encrypted)"
    },
    "check_address": {
      "type": "string",
      "description": "Mailing address for checks"
    },
    "is_primary": {
      "type": "boolean",
      "default": true,
      "description": "Primary payment method"
    }
  },
  "required": [
    "employee_id",
    "method_type"
  ]
}